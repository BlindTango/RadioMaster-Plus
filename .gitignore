# RadioMaster+ - Python wxPython media player
# Git ignore rules

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
.python312/
env/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Project specific
*.db
*.sqlite3
radiomaster.db

# Build artifacts
dist/
build/
*.spec
# ...except packaging/radiomaster.spec itself -- that's not disposable
# PyInstaller auto-gen output, it's the actual hand-maintained build
# recipe (hidden imports, data bundling, exclude_binaries, icon) that
# defines what actually ships. The blanket *.spec rule above meant it was
# never committed at all -- any fix made to it (including the
# exclude_binaries=True fix for the "_MEI...\python312.dll" onefile
# self-extraction failure) only ever existed on whichever machine
# happened to have it, with git never able to show a diff or track drift.
!packaging/radiomaster.spec
*.exe
*.msi

# Logs
*.log

# OS
Thumbs.db
.DS_Store

# Downloads and recordings (user data)
downloads/
recordings/

# Config (user-specific)
config/

# Portable-mode runtime data (created by --portable / dev runs)
/data/

# Bundled third-party binaries (ffmpeg/ffplay/ffprobe exceed GitHub's
# 100MB file limit anyway) -- fetched separately, not committed
tools/*.exe

# Test/automation caches and scratch logs
.pytest_cache/
@AutomationLog.txt
acclog.txt
